  "item": [
    {
      "name": "1. Login owner boca",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// 1. Check login was successful",
              "pm.test('Login status is 201', function() {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "// 2. Parse response",
              "var responseData = pm.response.json();",
              "console.log('Login Response Type:', typeof responseData);",
              "console.log('Response keys:', Object.keys(responseData));",
              "",
              "// 3. IMPORTANT: The token is inside tokenDTO!",
              "if (responseData.tokenDTO && responseData.tokenDTO.accessToken) {",
              "    var accessToken = responseData.tokenDTO.accessToken;",
              "    ",
              "    // Save to Trippy Local environment",
              "    pm.environment.set('boca_token', accessToken);",
              "    ",
              "    // Verify it was saved",
              "    var savedToken = pm.environment.get('boca_token');",
              "    console.log('✅ TOKEN SAVED SUCCESSFULLY');",
              "    console.log('Token:', savedToken.substring(0, 30) + '...');",
              "    console.log('Token length:', savedToken.length);",
              "    ",
              "    // Also save refresh token if needed",
              "    if (responseData.tokenDTO.refreshToken) {",
              "        pm.environment.set('boca_refresh_token', responseData.tokenDTO.refreshToken);",
              "    }",
              "} else {",
              "    console.error('❌ ERROR: Could not find tokenDTO.accessToken');",
              "    console.log('Full response structure:');",
              "    console.log(JSON.stringify(responseData, null, 2));",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"boca@trippy.com\",\n  \"password\": \"123456789\"\n}"
        },
        "url": "http://localhost:30002/sessions"
      }
    },

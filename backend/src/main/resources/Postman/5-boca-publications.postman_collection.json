    {
      "name": "3.  Crear hotel de boca",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// 1. Get token from environment",
              "var token = pm.environment.get('boca_token');",
              "console.log('=== DEBUG: Checking token ===');",
              "console.log('Environment variable boca_token:', token ? 'EXISTS' : 'MISSING');",
              "if (token) {",
              "    console.log('Token preview:', token.substring(0, 30) + '...');",
              "    console.log('Will send Authorization: Bearer ' + token.substring(0, 20) + '...');",
              "} else {",
              "    console.error('❌ ERROR: boca_token is empty or null');",
              "    console.error('Make sure Step 1 executed successfully');",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Check if hotel was created",
              "console.log('=== Hotel Creation Response ===');",
              "console.log('Status:', pm.response.status);",
              "if (pm.response.status === 201) {",
              "    console.log('✅ Hotel created successfully!');",
              "    var hotelData = pm.response.json();",
              "    if (hotelData.id) {",
              "        pm.environment.set('hotel_boca_id', hotelData.id);",
              "        console.log('Hotel ID saved:', hotelData.id);",
              "    }",
              "} else {",
              "    console.log('Response:', pm.response.text());",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{boca_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"title\": \"Hotel La Bombonera\",\n    \"description\": \"Hotel 4 estrellas temático de Boca Juniors. Ubicado a 50 metros de La Bombonera. Habitaciones decoradas con camisetas históricas. Desayuno 'Xeneize' incluido.\",\n    \"price\": 280.00,\n    \"location\": {\n        \"streetAddress\": \"Brandsen 805\",\n        \"city\": \"Buenos Aires\",\n        \"state\": \"CABA\",\n        \"country\": \"Argentina\",\n        \"zipCode\": \"1161\"\n    },\n    \"mainImageUrl\": \"{{image_boca_hotel_url}}\",\n    \"imageUrls\": [\n        \"{{image_boca_hotel_url}}\"\n    ],\n    \"roomCount\": 40,\n    \"capacity\": 80\n}"
        },
        "url": "http://localhost:30002/publications/hotel"
      }

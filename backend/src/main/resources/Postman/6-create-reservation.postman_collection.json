    {
      "name": "6. Advanced Tests",
      "item": [
        {
          "name": "TEST - Try to book own publication (should fail)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{river_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startDate\": \"2024-12-25\",\n  \"endDate\": \"2024-12-28\",\n  \"roomCount\": 1\n}"
            },
            "url": "{{base_url}}/publications/{{test_hotel_pub_id}}/reservations"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Should fail with 400', function() {",
                  "    pm.response.to.have.status(400);",
                  "    pm.response.to.have.body.that.includes('No podés reservar tu propia publicación');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TEST - Get all reservations for publication (as Host)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{river_token}}"
              }
            ],
            "url": "{{base_url}}/publications/{{test_hotel_pub_id}}/reservations/all"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "console.log('=== Host View - All Reservations ===');",
                  "if (pm.response.status === 200) {",
                  "    var reservations = pm.response.json();",
                  "    console.log(`Total reservations for this publication: ${reservations.length}`);",
                  "    reservations.forEach(res => {",
                  "        console.log(`\\n- ${res.travelerName} (${res.travelerEmail})`);",
                  "        console.log(`  Dates: ${res.checkIn} to ${res.checkOut}`);",
                  "        console.log(`  Status: ${res.status}`);",
                  "        console.log(`  Price: $${res.totalPrice}`);",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "TEST - Verify XP gained after reservation",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{agustin_token}}"
              }
            ],
            "url": "{{base_url}}/users/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.status === 200) {",
                  "    var user = pm.response.json();",
                  "    console.log('=== User XP/Level ===');",
                  "    console.log(`XP: ${user.xp}`);",
                  "    console.log(`Level: ${user.level}`);",
                  "    console.log(`Next Level XP: ${user.xpForNextLevel}`);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
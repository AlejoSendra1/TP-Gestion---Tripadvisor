    {
      "name": "3.  Crear hotel de river",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// 1. Get token from environment",
              "var token = pm.environment.get('river_token');",
              "console.log('=== DEBUG: Checking token ===');",
              "console.log('Environment variable river_token:', token ? 'EXISTS' : 'MISSING');",
              "if (token) {",
              "    console.log('Token preview:', token.substring(0, 30) + '...');",
              "    console.log('Will send Authorization: Bearer ' + token.substring(0, 20) + '...');",
              "} else {",
              "    console.error('❌ ERROR: river_token is empty or null');",
              "    console.error('Make sure Step 1 executed successfully');",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Check if hotel was created",
              "console.log('=== Hotel Creation Response ===');",
              "console.log('Status:', pm.response.status);",
              "if (pm.response.status === 201) {",
              "    console.log('✅ Hotel created successfully!');",
              "    var hotelData = pm.response.json();",
              "    if (hotelData.id) {",
              "        pm.environment.set('hotel_river_id', hotelData.id);",
              "        console.log('Hotel ID saved:', hotelData.id);",
              "    }",
              "} else {",
              "    console.log('Response:', pm.response.text());",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{river_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"title\": \"Hotel Monumental River\",\n    \"description\": \"Hotel exclusivo para hinchas de River Plate. Ubicado frente al Monumental. Todas las habitaciones tienen vista al estadio.\",\n    \"price\": 300.00,\n    \"location\": {\n        \"streetAddress\": \"Av. Pres. Figueroa Alcorta 7597\",\n        \"city\": \"Buenos Aires\",\n        \"state\": \"CABA\",\n        \"country\": \"Argentina\",\n        \"zipCode\": \"1428\"\n    },\n    \"mainImageUrl\": \"{{image_river_hotel_url}}\",\n    \"imageUrls\": [\n        \"{{image_river_hotel_url}}\"\n    ],\n    \"roomCount\": 50,\n    \"capacity\": 2\n}"
        },
        "url": "http://localhost:30002/publications/hotel"
